# =========================================================
# Núvol Lliure - Variables d'entorn (PLANTILLA)
#
# Copia este fitxer a .env i canvia tots els valors:
#   cp .env.example .env && chmod 600 .env
# El fitxer .env NO s'ha de pujar mai al repositori.
# =========================================================

# --- General ---
TZ=Europe/Madrid
DOMINI=nuvol.arreloberta.com

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=canvia-esta-contrasenya
NEXTCLOUD_TRUSTED_DOMAINS=nuvol.arreloberta.com

# --- Base de dades (MariaDB) ---
MYSQL_HOST=mariadb
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=canvia-esta-contrasenya
MARIADB_ROOT_PASSWORD=canvia-esta-contrasenya

# --- Redis ---
REDIS_HOST=redis
REDIS_HOST_PASSWORD=canvia-esta-contrasenya

# --- Còpies de seguretat (BorgBackup cap a BACKUP01) ---
BORG_REPO=ssh://borg@backup01.corp.arreloberta.com/./nuvol
BORG_PASSPHRASE=canvia-esta-contrasenya
