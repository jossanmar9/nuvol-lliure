# =========================================================
# Núvol Lliure - Variables d'entorn (EXEMPLE)
#
# Copia este fitxer a .env i substitueix els valors:
#   cp .env.example .env && chmod 600 .env
# El fitxer .env NO s'ha de pujar mai al repositori.
# =========================================================

# --- General ---
TZ=Europe/Madrid
DOMINI=cloud.exemple.local

# --- Plataforma de cloud (Nextcloud, pendent de confirmar en el disseny) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=canvia-esta-contrasenya
NEXTCLOUD_TRUSTED_DOMAINS=cloud.exemple.local

# --- Base de dades (motor pendent d'estudi: MariaDB / PostgreSQL) ---
DB_HOST=db
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=canvia-esta-contrasenya
DB_ROOT_PASSWORD=canvia-esta-contrasenya

# --- Memòria cau (Redis) ---
REDIS_HOST=redis
REDIS_PASSWORD=canvia-esta-contrasenya

# --- Integració amb Active Directory (LDAP/LDAPS) ---
LDAP_HOST=ldaps://dc01.exemple.local
LDAP_PORT=636
LDAP_BASE_DN=DC=exemple,DC=local
LDAP_BIND_DN=CN=svc-nextcloud,OU=Serveis,DC=exemple,DC=local
LDAP_BIND_PASSWORD=canvia-esta-contrasenya

# --- Certificats (proxy invers / HTTPS) ---
ACME_EMAIL=admin@exemple.local

# --- Còpies de seguretat ---
BACKUP_REPO=/mnt/backup/nuvol-lliure
BACKUP_PASSWORD=canvia-esta-contrasenya
